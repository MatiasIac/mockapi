{
  "name": "mockapi-msi",
  "version": "2.6.1",
  "description": "Mock API is a lightweight configurable HTTP API for testing and prototyping.",
  "main": "main.js",
  "scripts": {
    "start": "node ./main.js",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js"
  },
  "keywords": [
    "mock",
    "api",
    "testing",
    "prototyping",
    "http",
    "rest",
    "fake-api",
    "stub"
  ],
  "author": "Matias Iacono",
  "license": "ISC",
  "bin": {
    "mockapi": "main.js"
  },
  "files": [
    "main.js",
    "modules/",
    "apiHandlers/",
    "testdata/",
    "examples/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "swagger-ui-dist": "5.32.15",
    "yaml": "2.8.3"
  }
}
